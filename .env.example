# ─── Supabase ────────────────────────────────────────────────────────────────
# Copiá estos valores desde tu proyecto en https://supabase.com/dashboard
SUPABASE_URL=https://<tu-proyecto>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<anon-key>

VITE_SUPABASE_URL=https://<tu-proyecto>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<anon-key>
VITE_SUPABASE_PROJECT_ID=<tu-project-id>

# ─── TMDB (disponibilidad real por país) ─────────────────────────────────────
# Clave gratis en https://www.themoviedb.org/settings/api (uso no comercial,
# atribución a JustWatch por los watch providers). Acepta la API key v3 corta
# o el Read Access Token v4 (empieza con "eyJ"). Sin la clave, la validación
# de disponibilidad se apaga sola (los ítems pasan sin validar).
TMDB_API_KEY=<tu-api-key-de-tmdb>
# País default para validar disponibilidad cuando el cliente no manda el suyo.
DEFAULT_REGION=AR

# ─── Railway ─────────────────────────────────────────────────────────────────
# Railway inyecta PORT automáticamente. No hace falta definirlo.
# PORT=3000
