# ── Variables del build de la landing (VITE_*, públicas) ─────────────────────

# URL pública del manifest.json en Supabase Storage (bucket app-builds).
VITE_MANIFEST_URL=https://<proj>.supabase.co/storage/v1/object/public/app-builds/manifest.json

# URL del servicio web-control ya desplegado (link al pie).
# Si queda vacía, el link no se muestra.
VITE_WEB_CONTROL_URL=https://<web-control>.up.railway.app

# Código numérico de go.aftvnews.com que apunta a https://<esta-landing>/tv.
# La app Downloader (la que se usa para instalar en el televisor) lo acepta tal
# cual, así que el usuario tipea solo números con el control remoto en vez de una
# URL larga. Generalo una sola vez en https://go.aftvnews.com/ — como /tv siempre
# redirige al último APK, el código no hay que renovarlo en cada release.
# Si queda vacío, la landing muestra la URL <host>/tv en su lugar.
VITE_TV_DOWNLOADER_CODE=

# ── Solo para el script scripts/publish-build.mjs (local, NO en el build) ────

# SUPABASE_URL=https://<proj>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# BUILDS_BUCKET=app-builds
