# Backend que expone /api/transcribe (y el resto de la API de Miru).
# Por defecto usa el de Railway existente. Cambialo si tenés backend propio.
VITE_API_BASE_URL=https://cinefilo-production.up.railway.app

# Proyecto Supabase para el canal Realtime del pairing. DEBE ser el mismo que
# usan la app de TV y el /control original. Si se dejan vacíos, la app usa la
# publishable key por defecto (la misma commiteada en apps/tv).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Link para el CTA "Descargá la app" (Play Store o landing). Si queda vacío, el
# CTA muestra "Próximamente" en vez de un botón de descarga.
VITE_MOBILE_APP_URL=
