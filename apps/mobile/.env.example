# URL base de la API REST del backend Railway.
# En dev podés apuntar a localhost si corrés el server localmente.
VITE_API_BASE_URL=https://cinefilo-production.up.railway.app

# Token de lectura de TMDB (v4 Read Access Token).
# Obtenelo en: https://www.themoviedb.org/settings/api
VITE_TMDB_TOKEN=

# ElevenLabs TTS — clave y voice ID (opcional, si no está configurada el agente queda en modo silencioso)
# Obtenelo en: https://elevenlabs.io/app/settings/api-keys
VITE_ELEVENLABS_KEY=
# Voice ID por defecto: Antoni (cálida, multilingual). Podés cambiarlo desde el dashboard de ElevenLabs.
VITE_ELEVENLABS_VOICE_ID=ErXwobaYiN019PkySvjV
