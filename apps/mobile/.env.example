# URL base de la API REST del backend Railway.
# En dev podés apuntar a localhost si corrés el server localmente.
VITE_API_BASE_URL=https://cinefilo-production.up.railway.app

# Analytics PostHog (opcional — sin esto solo loguea en console.debug)
# Creá una cuenta gratis en https://posthog.com y copiá tu Project API Key
VITE_POSTHOG_KEY=

# NOTA: las claves de ElevenLabs (TTS) y demás secretos viven SOLO en el
# servidor (variables de Railway), nunca acá — todo lo que empiece con VITE_
# queda compilado dentro del APK y se puede extraer descompilando.
# Variables del servidor (Railway): ANTHROPIC_API_KEY, GROQ_API_KEY,
# ELEVENLABS_API_KEY, ELEVENLABS_VOICE_ID (opcional).
